# Copy to .env (same directory as docker-compose.yml). Used only for
# docker-compose variable substitution (build args, Caddy domains, mysql
# creds) — NOT read by the apps themselves. Each app still has its own
# apps/*/.env.production for its actual runtime secrets.

DOMAIN_WEB=app.your-domain.example
DOMAIN_ADMIN=admin.your-domain.example
DOMAIN_API=api.your-domain.example
ACME_EMAIL=you@your-domain.example

# Baked into apps/web and apps/admin's browser bundle at build time — must
# be the public API domain above, reachable from users' browsers.
VITE_API_URL=https://api.your-domain.example

MYSQL_ROOT_PASSWORD=change_me_to_a_long_random_value
MYSQL_DATABASE=sgs
