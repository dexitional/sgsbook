# Copy to .env.local for local dev, or .env.production for deploys.
# One env file now, for the merged app (previously split across
# apps/web, apps/admin, and apps/api's own .env.example files).

# Must match packages/db's DATABASE_URL — same MySQL database. Used both by
# the customer server functions and by the folded-in Hono API modules.
DATABASE_URL="mysql://root:your_password_here@localhost:3306/sgs"

# Better-auth (customer sign-in only). The handler is mounted at its
# conventional /api/auth/$ path (this app deploys at its own domain root,
# no path prefix), so BETTER_AUTH_URL just needs the origin:
#   local dev:  http://localhost:3000
#   production: https://cdn.ucc.edu.gh
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate: npx -y @better-auth/cli secret

# Google OAuth — customer sign-in only.
# Redirect URI: http://localhost:3000/api/auth/callback/google
#           (production: https://cdn.ucc.edu.gh/api/auth/callback/google)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Admin (staff) auth — custom credential login against the sso_* RBAC tables.
# Generate a real random 32+ char secret before shipping.
ADMIN_SESSION_SECRET=your_random_secret_here

# Anthropic SDK — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=your_key_here

# Unosend transactional email — https://www.unosend.co / docs.unosend.co
UNOSEND_API_KEY=un_your_key_here
UNOSEND_FROM_ADDRESS=bookings@your-domain.example
UNOSEND_FROM_NAME="University Bookings"

# Cloudflare R2 — facility/client photo uploads. The API only issues presigned
# PUT URLs; the browser uploads the file bytes directly to R2, so the bucket's
# CORS policy must allow PUT from wherever this app is served.
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_DOMAIN=https://cdn.your-domain.example
