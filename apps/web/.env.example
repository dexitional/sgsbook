# Copy to .env.local and fill in real values for local dev.

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate: npx -y @better-auth/cli secret

# Google OAuth — customer sign-in only.
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Must match packages/db's DATABASE_URL.
DATABASE_URL="mysql://root:your_password_here@localhost:3306/sgs"

VITE_API_URL=http://localhost:4000
